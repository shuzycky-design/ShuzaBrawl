            void NewCommand(SkinData skinData, LogicGiveDeliveryItemsCommand command)
            {
                if (skinData == null) return;
                DeliveryUnit unit = new DeliveryUnit(100);
                GatchaDrop reward = new GatchaDrop(9);
                foreach (EmoteData emoteData in DataTables.Get(DataType.Emote).GetDatas())
                {

                    if (emoteData.Skin == skinData.Name)
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.Emote).GetData<EmoteData>(emoteData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }

                }
                foreach (PlayerThumbnailData playerThumbnailData in DataTables.Get(DataType.PlayerThumbnail).GetDatas())
                {
                    if (playerThumbnailData.CatalogPreRequirementSkin == skinData.Name)
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.PlayerThumbnail).GetData<PlayerThumbnailData>(playerThumbnailData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }

                }
                command.DeliveryUnits.Add(unit);
                command.Execute(HomeMode);

                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);

            }
        }


private OfferBundle GenerateDailyGift()
{
    // 1. Привязываем рандом к ID игрока и текущей дате.
    // Теперь подарок будет одинаковым весь день и не изменится при перезаходе.
    int seed = (int)(HomeId + DateTime.UtcNow.DayOfYear + DateTime.UtcNow.Year);
    Random rand = new Random(seed);

    bool isJackpot = rand.Next(0, 100) < 10; // 10% шанс
    int rewardType = rand.Next(0, 3); // 0 - монеты, 1 - очки силы, 2 - кредиты
    int amount = 0;
    ShopItem itemType = ShopItem.Coin;

    switch (rewardType)
    {
        case 0:
            itemType = ShopItem.Coin;
            amount = isJackpot ? 500 : 20;
            break;
        case 1:
            itemType = ShopItem.PowerPoint;
            amount = isJackpot ? 200 : 15;
            break;
        case 2:
            itemType = ShopItem.RecruitToken;
            amount = isJackpot ? 100 : 5;
            break;
    }

    OfferBundle bundle = new OfferBundle();
    bundle.IsDailyDeals = true; 
    bundle.IsTrue = true;        
    bundle.OfferType = 1;        
    bundle.offerId = 100;
    bundle.EndTime = DateTime.UtcNow.Date.AddDays(1).AddHours(8); 
    bundle.Cost = 0;
    bundle.Currency = 0;

    // 2. ГЛАВНОЕ ИСПРАВЛЕНИЕ: Уникальный ключ с полной датой (Год-Месяц-День)
    // Теперь завтра ключ будет другим, и подарок не будет считаться собранным.
    bundle.Claim = "DailyGift_" + DateTime.UtcNow.ToString("yyyyMMdd"); 

    bundle.Title = isJackpot ? "ДЖЕКПОТ!" : "БЕСПЛАТНО";
    bundle.BackgroundExportName = isJackpot ? "offer_bgr_legendary" : "offer_bgr_daily_deal"; 
    bundle.rasstanovka = 1;

    // Проверяем, забирали ли мы именно СЕГОДНЯШНИЙ подарок
    if (OffersClaimed.Contains(bundle.Claim))
    {
        bundle.Purchased = true;
    }

    Offer offer = new Offer(itemType, amount, 0, 0);
    bundle.Items.Add(offer);

    return bundle;
}



