            stream.WriteVInt(3); // chain offers

            stream.WriteBoolean(true); // ChronosTextEntry
            stream.WriteString("НАГРАДЫ ВЫДАЮТСЯ АВТО!"); // Subtitle
            stream.WriteVInt(0); // IsTid
            stream.WriteVInt(1);
            stream.WriteDataReference(69, 9); // Attached customize
