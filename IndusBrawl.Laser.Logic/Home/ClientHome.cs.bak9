        public void PurchaseOfferWithCatalog(int DataGlobalId, int Currency)
        {
            LogicGiveDeliveryItemsCommand command = new LogicGiveDeliveryItemsCommand();
            if (DataGlobalId > 29000000 && DataGlobalId < 30000000)
            {
                SkinData skinData = DataTables.Get(DataType.Skin).GetDataWithId<SkinData>(DataGlobalId);
                int blingsNeeded = skinData.PriceBling;
                int gemsNeeded = skinData.PriceGems;

                int playerBlings = HomeMode.Avatar.Blings;
                int playerGems = HomeMode.Avatar.Diamonds;

                bool enoughBlings = playerBlings >= blingsNeeded;
                bool enoughGems = playerGems >= gemsNeeded;

                // Комбинированная оплата: если не хватает блингов, остаток списывается гемами
                if (Currency == 2 || Currency == 3) // Покупка за блинги с возможностью докупить за гемы
                {
                    if (playerBlings >= blingsNeeded)
                    {
                        if (!HomeMode.Avatar.UseBlings(blingsNeeded)) 
                        {
                            Console.WriteLine($"Failed to use blings for skin purchase. PlayerId: {HomeId}, SkinId: {DataGlobalId}");
                            return;
                        }
                    }
                    else
                    {
                        int blingsUsed = playerBlings;
                        int blingsShortage = blingsNeeded - blingsUsed;
                        int gemsForShortage = (int)Math.Ceiling((double)blingsShortage / (blingsNeeded / (double)gemsNeeded));

                        if (blingsUsed > 0)
                        {
                            if (!HomeMode.Avatar.UseBlings(blingsUsed)) 
                            {
                                Console.WriteLine($"Failed to use partial blings for skin purchase. PlayerId: {HomeId}, SkinId: {DataGlobalId}");
                                return;
                            }
                        }
                        if (playerGems < gemsForShortage) 
                        {
                            Console.WriteLine($"Not enough gems to cover shortage. PlayerId: {HomeId}, SkinId: {DataGlobalId}, Needed: {gemsForShortage}, Available: {playerGems}");
                            return;
                        }
                        if (!HomeMode.Avatar.UseDiamonds(gemsForShortage)) 
                        {
                            Console.WriteLine($"Failed to use gems for skin purchase. PlayerId: {HomeId}, SkinId: {DataGlobalId}");
                            return;
                        }
                    }
                }
                else if (Currency == 1) // Покупка только за гемы
                {
                    if (!HomeMode.Avatar.UseDiamonds(gemsNeeded)) 
                    {
                        Console.WriteLine($"Failed to use diamonds for skin purchase. PlayerId: {HomeId}, SkinId: {DataGlobalId}");
                        return;
                    }
                }
                else
                {
                    // Неизвестная валюта — отменяем покупку
                    Console.WriteLine($"Unknown currency type for skin purchase. PlayerId: {HomeId}, Currency: {Currency}");
                    return;
                }

                // Подтверждение успешного списания валют
                Console.WriteLine($"Skin purchase successful. PlayerId: {HomeId}, SkinId: {DataGlobalId}, BlingsUsed: {(Currency == 2 || Currency == 3 ? (enoughBlings ? blingsNeeded : playerBlings) : 0)}, GemsUsed: {(Currency == 1 ? gemsNeeded : (enoughBlings ? 0 : (int)Math.Ceiling((double)(blingsNeeded - playerBlings) / (blingsNeeded / (double)gemsNeeded))))}");

                DeliveryUnit unit = new DeliveryUnit(100);
                GatchaDrop reward = new GatchaDrop(9);
                reward.SkinGlobalId = DataGlobalId;
                reward.Count = 1;
                unit.AddDrop(reward);

                command.DeliveryUnits.Add(unit);
                command.Execute(HomeMode);
                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);
                NewCommand(skinData);
            }
            else if (DataGlobalId > 52000000 && DataGlobalId < 53000000)
            {
                EmoteData emoteData = DataTables.Get(DataType.Emote).GetDataWithId<EmoteData>(DataGlobalId);
                int blingsNeeded = emoteData.PriceBling;
                int gemsNeeded = emoteData.PriceGems;

                int playerBlings = HomeMode.Avatar.Blings;
                int playerGems = HomeMode.Avatar.Diamonds;

                bool enoughBlings = playerBlings >= blingsNeeded;
                bool enoughGems = playerGems >= gemsNeeded;

                // Комбинированная оплата: если не хватает блингов, остаток списывается гемами
                if (Currency == 2 || Currency == 3) // Покупка за блинги с возможностью докупить за гемы
                {
                    if (playerBlings >= blingsNeeded)
                    {
                        if (!HomeMode.Avatar.UseBlings(blingsNeeded)) 
                        {
                            Console.WriteLine($"Failed to use blings for pin purchase. PlayerId: {HomeId}, PinId: {DataGlobalId}");
                            return;
                        }
                    }
                    else
                    {
                        int blingsUsed = playerBlings;
                        int blingsShortage = blingsNeeded - blingsUsed;
                        int gemsForShortage = (int)Math.Ceiling((double)blingsShortage / (blingsNeeded / (double)gemsNeeded));

                        if (blingsUsed > 0)
                        {
                            if (!HomeMode.Avatar.UseBlings(blingsUsed)) 
                            {
                                Console.WriteLine($"Failed to use partial blings for pin purchase. PlayerId: {HomeId}, PinId: {DataGlobalId}");
                                return;
                            }
                        }
                        if (playerGems < gemsForShortage) 
                        {
                            Console.WriteLine($"Not enough gems to cover shortage. PlayerId: {HomeId}, PinId: {DataGlobalId}, Needed: {gemsForShortage}, Available: {playerGems}");
                            return;
                        }
                        if (!HomeMode.Avatar.UseDiamonds(gemsForShortage)) 
                        {
                            Console.WriteLine($"Failed to use gems for pin purchase. PlayerId: {HomeId}, PinId: {DataGlobalId}");
                            return;
                        }
                    }
                }
                else if (Currency == 1) // Покупка только за гемы
                {
                    if (!HomeMode.Avatar.UseDiamonds(gemsNeeded)) 
                    {
                        Console.WriteLine($"Failed to use diamonds for pin purchase. PlayerId: {HomeId}, PinId: {DataGlobalId}");
                        return;
                    }
                }
                else
                {
                    // Неизвестная валюта — отменяем покупку
                    Console.WriteLine($"Unknown currency type for pin purchase. PlayerId: {HomeId}, Currency: {Currency}");
                    return;
                }

                // Подтверждение успешного списания валют
                Console.WriteLine($"Pin purchase successful. PlayerId: {HomeId}, PinId: {DataGlobalId}, BlingsUsed: {(Currency == 2 || Currency == 3 ? (enoughBlings ? blingsNeeded : playerBlings) : 0)}, GemsUsed: {(Currency == 1 ? gemsNeeded : (enoughBlings ? 0 : (int)Math.Ceiling((double)(blingsNeeded - playerBlings) / (blingsNeeded / (double)gemsNeeded))))}");

                DeliveryUnit unit = new DeliveryUnit(100);
                GatchaDrop reward = new GatchaDrop(11);
                reward.DataGlobalId = DataGlobalId;
                reward.Count = 1;
                unit.AddDrop(reward);
                command.DeliveryUnits.Add(unit);
                command.Execute(HomeMode);
                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);
            }
            else if (DataGlobalId > 28000000 && DataGlobalId < 29000000)
            {
                PlayerThumbnailData skinData = DataTables.Get(DataType.PlayerThumbnail).GetDataWithId<PlayerThumbnailData>(DataGlobalId);
                if (Currency == 1) // Gems
                {
                    if (!HomeMode.Avatar.UseDiamonds(skinData.PriceGems)) return;
                }
                if (Currency == 2) // Blings
                {
                    if (!HomeMode.Avatar.UseBlings(skinData.PriceBling)) return;
                }

                DeliveryUnit unit = new DeliveryUnit(100);
                GatchaDrop reward = new GatchaDrop(11);
                reward.DataGlobalId = DataGlobalId;
                reward.Count = 1;
                unit.AddDrop(reward);



                command.DeliveryUnits.Add(unit);
                command.Execute(HomeMode);
                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);

            }

            void NewCommand(SkinData skinData)
            {
                Quests = new Quests();
                Quests.AddRandomQuests(HomeMode.Avatar.Heroes, 8);

                LogicHeroWinQuestsChangedCommand cmd = new LogicHeroWinQuestsChangedCommand();
                cmd.Quests = Quests;

                AvailableServerCommandMessage message12 = new AvailableServerCommandMessage();
                message12.Command = cmd;
                HomeMode.GameListener.SendMessage(message12);

                DeliveryUnit unit = new DeliveryUnit(100);
                GatchaDrop reward = new GatchaDrop(9);
                foreach (EmoteData emoteData in DataTables.Get(DataType.Emote).GetDatas())
                {

                    if (emoteData.Skin == skinData.Name)
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.Emote).GetData<EmoteData>(emoteData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }

                }
                foreach (PlayerThumbnailData playerThumbnailData in DataTables.Get(DataType.PlayerThumbnail).GetDatas())
                {
                    if (playerThumbnailData.CatalogPreRequirementSkin == skinData.Name)
                    {
                        GatchaDrop reward1 = new GatchaDrop(11);
                        reward1.DataGlobalId = DataTables.Get(DataType.PlayerThumbnail).GetData<PlayerThumbnailData>(playerThumbnailData.Name).GetGlobalId();
                        reward1.Count = 1;
                        unit.AddDrop(reward1);
                    }

                }
                command.DeliveryUnits.Add(unit);
                command.Execute(HomeMode);

                AvailableServerCommandMessage message = new AvailableServerCommandMessage();
                message.Command = command;
                HomeMode.GameListener.SendMessage(message);

            }
        }

